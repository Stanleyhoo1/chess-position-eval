# Model inference service: python server.py --no-static, proxied by nginx at /api/.
# Build context is the repo root (see docker-compose.yml), so COPY paths are relative to it.
FROM python:3.12-slim

WORKDIR /app

# CPU-only PyTorch keeps the image far smaller than the default CUDA build.
# chess_eval needs only torch, numpy (FEN encoder) and python-chess (search).
RUN pip install --no-cache-dir torch numpy chess --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple

COPY chess_eval/ ./chess_eval/
COPY server.py ./
# The checkpoint is bind-mounted from ./models in docker-compose.yml, so a
# retrained model only needs a container restart, not a rebuild.

EXPOSE 8000
CMD ["python", "server.py", "--no-static", "--cpu", "--host", "0.0.0.0", "--port", "8000"]
